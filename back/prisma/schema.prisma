// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs" 
  // "Matches Prisma's output format with NestJS's CommonJS runtime environment."
  // (https://medium.com/@msmiraj8/get-started-with-prisma-7-with-nest-js-mysql-3919eaa7c760)
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Form {
  id          String     @id @default(uuid())
  active      Boolean    @default(true)
  title       String     @db.VarChar(300)
  description String?    @db.VarChar(3000)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt @default(now())
  questions   Question[]
  submissions Submission[]
}

model Question {
  id        String        @id @default(uuid())
  active    Boolean       @default(true)
  title     String        @db.VarChar(10000)
  formId    String
  required  Boolean       @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt @default(now())

  form      Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  options   Option[]
  answers   Answer[]
}

enum OptionType {
  INPUT
  MARKDOWN
}

model Option {
  id              String      @id @default(uuid())
  active          Boolean     @default(true)
  description     String      @db.VarChar(2000)
  type            OptionType  @default(MARKDOWN)
  correct         Boolean     @default(false)
  questionId      String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt @default(now())

  question        Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Submission {
  id          String   @id @default(uuid())
  active      Boolean  @default(true)
  user        String   @db.VarChar(300)
  formId      String   
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt @default(now())

  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers     Answer[]
}

model Answer {
  id           String      @id @default(uuid())
  active       Boolean     @default(true)
  submissionId String 
  questionId   String
  optionId     String?     // OptionType.MARKDOWN
  textValue    String?     @db.VarChar(5000) // OptionType.INPUT
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt @default(now())

  submission   Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question     Question    @relation(fields: [questionId], references: [id])
}